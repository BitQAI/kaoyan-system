# 复制为 .env 并填值（chmod 600）。生成密码散列：
#   .venv/bin/python -c "from app.auth import hash_password; print(hash_password('你的密码'))"
KY_PASSWORD_HASH=
KY_SESSION_SECRET=

# AI 对话通道：opencode（默认，deepseek-v4.1-flash，需 x-opencode-session）| bailian（兜底）
AI_PROVIDER=opencode
OPENCODE_GO_KEY=
OPENCODE_GO_BASE=https://opencode.ai/zen/go/v1
BAILIAN_KEY=
BAILIAN_BASE=

# 可选覆盖
# KY_DB_PATH=/path/to/data/kaoyan.db
# KY_CONTENT_DIR=/path/to/content
# KY_DATA_DIR=/path/to/data
